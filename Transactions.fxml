
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="800.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="TransactionsController">

    <children>

        <VBox prefWidth="200.0"
              prefHeight="600.0"
              spacing="20.0"
              alignment="TOP_CENTER"
              style="-fx-background-color: #172554; -fx-padding: 25px;">

            <children>
                <Label text="Thobo's Bank"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />

                <Button text="Dashboard"
                        onAction="#handleDashboard"
                        prefWidth="150.0"
                        prefHeight="40.0" />

                <Button text="My Accounts"
                        onAction="#handleAccounts"
                        prefWidth="150.0"
                        prefHeight="40.0" />

                <Button text="Transactions"
                        prefWidth="150.0"
                        prefHeight="40.0" />
            </children>
        </VBox>

        <AnchorPane layoutX="200.0"
                    prefWidth="600.0"
                    prefHeight="600.0">

            <children>

                <Label text="Transactions"
                       layoutX="30.0"
                       layoutY="30.0"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172554;" />

                <Label text="View your recent deposits and withdrawals."
                       layoutX="30.0"
                       layoutY="70.0"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748B;" />

                <TableView fx:id="transactionsTable"
                           layoutX="30.0"
                           layoutY="120.0"
                           prefWidth="540.0"
                           prefHeight="400.0">

                    <columns>
                        <TableColumn text="ID" prefWidth="60.0" />
                        <TableColumn text="Account" prefWidth="120.0" />
                        <TableColumn text="Type" prefWidth="110.0" />
                        <TableColumn text="Amount (BWP)" prefWidth="120.0" />
                        <TableColumn text="Date" prefWidth="130.0" />
                    </columns>

                </TableView>

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
