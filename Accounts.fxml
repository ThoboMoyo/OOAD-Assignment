
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="800.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="AccountsController">

    <children>

        <VBox prefWidth="200.0"
              prefHeight="600.0"
              spacing="20.0"
              alignment="TOP_CENTER"
              style="-fx-background-color: #172554; -fx-padding: 25px;">

            <children>
                <Label text="Thobo's Bank"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />

                <Button text="Dashboard"
                        onAction="#handleDashboard"
                        prefWidth="150.0"
                        prefHeight="40.0" />

                <Button text="My Accounts"
                        prefWidth="150.0"
                        prefHeight="40.0" />
            </children>
        </VBox>

        <AnchorPane layoutX="200.0"
                    prefWidth="600.0"
                    prefHeight="600.0">

            <children>

                <Label text="My Accounts"
                       layoutX="30.0"
                       layoutY="30.0"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172554;" />

                <Label text="View your bank account information and balances."
                       layoutX="30.0"
                       layoutY="70.0"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748B;" />

                <TableView fx:id="accountsTable"
                           layoutX="30.0"
                           layoutY="120.0"
                           prefWidth="540.0"
                           prefHeight="400.0">

                    <columns>
                        <TableColumn text="Account Number" prefWidth="130.0" />
                        <TableColumn text="Account Type" prefWidth="140.0" />
                        <TableColumn text="Branch" prefWidth="120.0" />
                        <TableColumn text="Balance (BWP)" prefWidth="150.0" />
                    </columns>

                </TableView>

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
